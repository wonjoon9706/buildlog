APP_NAME=BuildLog API
APP_ENV=development
API_PREFIX=/api
DATABASE_URL=sqlite:///./buildlog.db
FRONTEND_ORIGIN=http://localhost:5173

# postgresql:// Supabase URLs are converted to the psycopg 3 driver automatically.

# Supabase를 연결할 때 DATABASE_URL을 Supabase의 PostgreSQL 연결 문자열로 바꿉니다.
# 실제 비밀번호가 포함된 연결 문자열은 .env에만 저장하고 이 파일에는 넣지 않습니다.
